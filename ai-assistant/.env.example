# Copy to .env and edit. Never commit the real .env file.

# Require this value in the X-API-Key header for every /agent/* request.
# Leave empty only for local development.
API_KEY=

# Comma-separated browser origins allowed to call the API, e.g.
# https://portal.example-hospital.org,https://staging.example-hospital.org
# Leave empty if the API is called server-to-server or from the same origin.
CORS_ORIGINS=

# Set both to false in production if you don't want the built-in pages.
ENABLE_DOCS=false

LOG_LEVEL=INFO
PORT=8000
